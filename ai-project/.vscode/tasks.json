{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/ai-project" }
    },
    {
      "label": "Run (dev)",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/ai-project" },
      "isBackground": true
    },
    {
      "label": "Docker: Compose up (dev)",
      "type": "shell",
      "command": "docker compose -f docker-compose.dev.yml up --build",
      "options": { "cwd": "${workspaceFolder}/ai-project" }
    }
    ,
    {
      "label": "Docker: Build image",
      "type": "shell",
      "command": "docker build -f Dockerfile -t ai-project:latest .",
      "options": { "cwd": "${workspaceFolder}/ai-project" }
    },
    {
      "label": "Docker: Run image",
      "type": "shell",
      "command": "docker run --rm -p 8000:8000 --name ai-project-dev ai-project:latest",
      "options": { "cwd": "${workspaceFolder}/ai-project" },
      "isBackground": true
    },
    {
      "label": "Docker: Stop container",
      "type": "shell",
      "command": "docker stop ai-project-dev || true",
      "options": { "cwd": "${workspaceFolder}/ai-project" }
    }
  ]
}
