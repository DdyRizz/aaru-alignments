FROM node:18-alpine
WORKDIR /app

# Install build tools and deps
RUN apk add --no-cache bash git python3 make g++

# Copy package files first
COPY package*.json ./

# Install dev dependencies for nodemon if present
RUN npm install

# Install nodemon globally if not present
RUN npm i -g nodemon || true

# Copy source
COPY . .

ENV NODE_ENV=development
EXPOSE 3000
CMD ["nodemon", "--legacy-watch", "webhook.js"]
